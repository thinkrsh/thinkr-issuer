# The settings of the issuer on the server, behind Cloudflare and Caddy (24 Oct 2026). Not secret.
# Cloudflare puts the address of the visitor in this header; the server takes requests from Cloudflare only.
CLIENT_ADDRESS_HEADER=CF-Connecting-IP
# The key that signs vouchers, piped from secret/voucher-key.pem by scripts/issuer/deploy.sh keys.
VOUCHER_KEY_FILE=/etc/thinkr-issuer/voucher-key.pem
# The keys of holder vouchers, one for each month, copied from secret/holder-keys/ by the same part.
HOLDER_KEYS_DIR=/etc/thinkr-issuer/holder-keys
# The ledger of the issuer, in the state folder that systemd gives the issuer (StateDirectory).
DATABASE_FILE=/var/lib/thinkr-issuer/ledger.db
# The factory of the deposit addresses of claims by transfer (apps/contracts), deployed on Robinhood
# Chain on 27 Oct 2026 in block 99292118. Not secret.
CLAIM_FACTORY=0xa638F6bB5314e9F3Be61A67E49Bea2732c11cd09
# The key of the claim wallet, piped from secret/claim-operator-key.txt by scripts/issuer/deploy.sh keys.
CLAIM_OPERATOR_KEY_FILE=/etc/thinkr-issuer/claim-operator-key.txt
# Top-ups in privacy coins (docs/COIN-TOP-UPS-GO-LIVE.md): Zcash first, Monero once its node has
# synced. The wallet holds a viewing key only, on the loopback of the server.
COIN_TOP_UPS=zec
ZCASH_WALLETD_URL=http://127.0.0.1:8000
# The keys of the notes of change, copied from secret/change-keys by scripts/issuer/deploy.sh keys.
CHANGE_KEYS_DIR=/etc/thinkr-issuer/change-keys
