# Settings of the issuer on the laptop of the owner, loaded by npm run dev and start.
# Not secret: the voucher key that it names lives in secret/, and the ledger in .data/.
VOUCHER_KEY_FILE=../../secret/voucher-dev.pem
HOLDER_KEYS_DIR=../../secret/holder-keys-dev
DATABASE_FILE=.data/ledger.db
# The factory of the deposit addresses of claims by transfer (apps/contracts), on Robinhood Chain.
# The laptop settles with the same claim wallet as the server: a claim by transfer on dev is real.
CLAIM_FACTORY=0xa638F6bB5314e9F3Be61A67E49Bea2732c11cd09
CLAIM_OPERATOR_KEY_FILE=../../secret/claim-operator-key.txt
