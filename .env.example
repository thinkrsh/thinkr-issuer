# The issuer reads these variables at startup and stops when one is missing or invalid.
# Settings live in env/: local.env on the laptop, server.env on the server.
# Optional. The header with the address of the visitor behind a proxy, such as CF-Connecting-IP.
CLIENT_ADDRESS_HEADER=
# The RSA private key (PEM) that signs vouchers: secret/voucher-dev.pem on the laptop (env/local.env),
# /etc/thinkr-issuer/voucher-key.pem on the server (env/server.env).
VOUCHER_KEY_FILE=
# The folder of the keys of holder vouchers, one RSA private key for each month, as 2026-10.pem:
# secret/holder-keys-dev/ on the laptop, /etc/thinkr-issuer/holder-keys/ on the server.
# npm run holder-keys -- make <folder> <first month> <months> makes them.
HOLDER_KEYS_DIR=
# The SQLite file of the ledger of the issuer.
DATABASE_FILE=
# Optional. The wallets that may top up while payment runs on a testnet, comma-separated.
TESTNET_PAYERS=
# Optional. The RPC that the issuer reads the chain from, such as the endpoint of a provider with its
# key in the URL (keep that in secret/). Unset, the public RPC of the chain, which is rate limited.
CHAIN_RPC_URL=
# The factory of the deposit addresses of claims by transfer (apps/contracts), as deployed on
# Robinhood Chain. Not secret: it goes in env/server.env and env/local.env.
CLAIM_FACTORY=
# The private key of the claim wallet, the operator of that factory, as 0x hex in a file of its own:
# secret/claim-operator-key.txt on the laptop, /etc/thinkr-issuer/claim-operator-key.txt on the server.
CLAIM_OPERATOR_KEY_FILE=
